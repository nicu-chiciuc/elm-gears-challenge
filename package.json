{
  "name": "elm-gears-challenge",
  "private": true,
  "scripts": {
    "build": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && elm-package install --yes && elm-make Main.elm --output=dist/index.html",
    "deploy": "alchemy deploy --env-file /dev/null --stage prod --no-input"
  },
  "devDependencies": {
    "elm": "0.18.0-exp5",
    "wrangler": "4.145.0",
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@effect/platform-node": "4.0.5",
    "@samebase/alchemy-convex": "0.20.0",
    "alchemy": "2.0.0-beta.84",
    "convex": "1.48.0",
    "effect": "4.0.5"
  },
  "overrides": {
    "graceful-fs": "4.2.11",
    "@effect/platform-node-shared": "4.0.5",
    "@effect/sql-d1": "4.0.5"
  }
}
